{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComfyNeko",
  "version": "0.1.0",
  "identifier": "com.kuroii.comfyneko",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ComfyNeko",
        "width": 1180,
        "height": 780,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/cache/thumbnails/**/*", "$APPLOCALDATA/cache/previews/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
